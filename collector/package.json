{
  "name": "scrimstats-collector",
  "version": "0.6.0",
  "private": true,
  "description": "Windows companion for champion-select, live-game, and post-game ScrimStats captures",
  "author": "ScrimStats",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "tsx --test test/**/*.test.ts",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "directories": { "output": "release", "buildResources": "build" },
    "appId": "gg.scrimstats.collector",
    "productName": "ScrimStats Game Capture",
    "files": ["dist/**", "package.json"],
    "extraResources": [{ "from": "build/icon.png", "to": "icon.png" }],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "ScrimStats-Game-Capture-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "asar": true
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
